#include <iostream>

using namespace std;

class M1C {
private:
    int spt;
    int a[200];
 // neu spt >250 them if > 200

public:
    void nhap();
    void xuat();
    void sapxep();
    void xoak(int k);
    void chenk(int k);
};

void M1C::nhap() {
    cout << "Nhap so luong phan tu: ";
    cin >> spt;
    cout << "Nhap cac phan tu:\n";
    for (int i = 0; i < spt; i++) {
        cout << "a[" << i << "] = ";
        cin >> a[i];
    }
}

void M1C::xuat() {
    cout << "Mang hien tai: ";
    for (int i = 0; i < spt; i++) {
        cout << a[i] << " ";
    }
    cout << "\n";
}

void M1C::sapxep() {
    for (int i = 0; i < spt - 1; i++) {
        for (int j = i + 1; j < spt; j++) {
            if (a[i] > a[j]) {
                int temp = a[i];
                a[i] = a[j];
                a[j] = temp;
            }
        }
    }
    cout << "Ða sap xep mang tang dan!\n";
}

void M1C::xoak(int k) {
    if (k < 0 || k >= spt) {
        cout << "Vi tri xoa khong hop le!\n";
        return;
    }
    for (int i = k; i < spt - 1; i++) {
        a[i] = a[i + 1];
    }
    spt--;
    cout << "Ða xoa tai vi tri " << k << " thanh cong!\n";
}

void M1C::chenk(int k) {
    if (k < 0 || k > spt || spt >= 200) {
        cout << "Vi tri chen khong hop le hoac mang day!\n";
        return;
    }
    int x;
    cout << "Nhap gia tri phan tu can chen (x): ";
    cin >> x;

    for (int i = spt; i > k; i--) {
        a[i] = a[i - 1];
    }
    a[k] = x;
    spt++;
    cout << "Ða chen " << x << " vao vi tri " << k << " thanh cong!\n";
}

int main() {
    M1C obj;

    obj.nhap();
    obj.xuat();

    obj.sapxep();
    obj.xuat();

    obj.chenk(1);
    obj.xuat();

    obj.xoak(2);
    obj.xuat();

    return 0;
}
